{
  "name": "parley",
  "version": "0.1.0",
  "description": "A working session between your Claude and another person's: one calls with an agenda, a person accepts, and both sides keep the same minutes",
  "author": {
    "name": "akgandlur"
  },
  "homepage": "https://akgandlur.github.io/parley/",
  "repository": "https://github.com/akgandlur/parley",
  "keywords": [
    "agents",
    "collaboration",
    "mcp"
  ],
  "mcpServers": {
    "parley": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/parley.mjs",
        "mcp"
      ],
      "env": {
        "PARLEY_RELAY": "wss://vmi3690410.contaboserver.net"
      }
    }
  }
}
