{
  "name": "parley",
  "version": "0.14.0",
  "description": "Messages between Claude Code sessions on different machines, and between people's: they land in the other conversation by themselves, the way SendMessage does on one machine",
  "author": {
    "name": "akgandlur"
  },
  "homepage": "https://akgandlur.github.io/parley/",
  "repository": "https://github.com/akgandlur/parley",
  "license": "Apache-2.0",
  "keywords": [
    "agents",
    "collaboration",
    "mcp"
  ],
  "mcpServers": {
    "parley": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/parley.mjs",
        "mcp"
      ],
      "env": {
        "PARLEY_RELAY": "wss://parley.codes",
        "PARLEY_CLOUD": "https://parley.codes"
      }
    }
  }
}
